# Free key: https://aistudio.google.com/apikey  (never turn on billing = stays free)
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BACKUP_MODEL=gemini-flash-latest

# base.en = fast. If it mishears you, try small.en (slower, more accurate)
WHISPER_MODEL=base.en

# app = standalone Edge window (fastest), window = always-on-top window, browser = a tab
HUD=app

# Only for part 6 (Telegram). Token from @BotFather, your id from @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=
